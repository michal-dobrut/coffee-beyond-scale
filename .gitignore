# --- Project data & artifacts ---
# Photographs and trained weights are not committed. The records that sit
# beside them are: the sheet a person writes and the YAML the pipeline reads,
# as docs/records.md sets out. Re-including directories is what lets those
# negations reach any depth -- a negation cannot reach inside an excluded
# directory.
data/**
!data/**/
!data/**/session.md
!data/**/session.yaml
!data/manifest.csv
models/

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Private notes: discussion, session logs, plans (own nested git repo) ---
notes/
